{
  "name": "dnd-platform",
  "private": true,
  "engines": { "node": ">=20" },
  "scripts": {
    "dev:api": "pnpm --filter @dnd/api start:dev",
    "dev:web": "pnpm --filter @dnd/web dev",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "build": "pnpm -r build",
    "prepare": "pnpm --filter @dnd/shared build"
  },
  "devDependencies": {
    "prettier": "^3.3.0",
    "typescript": "^5.5.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "@prisma/client", "prisma", "argon2", "@sentry/node"]
  }
}
