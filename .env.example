DATABASE_URL=postgresql://dnd:dnd@localhost:5432/dnd
# The API refuses to start if this is shorter than 32 characters — generate a real
# random value for any non-local environment, e.g. `openssl rand -base64 32`.
JWT_SECRET=
JWT_EXPIRES_IN=7d
PORT=3000
SENTRY_DSN=
# Not needed for normal local dev — Vite already proxies /api same-origin (apps/web/vite.config.ts),
# same as nginx does in production. Only set this if a browser needs to call the API directly from
# a *different* origin during development. Comma-separated list of allowed origins; unset = no CORS.
CORS_ORIGIN=
# Number of trusted reverse-proxy hops in front of the API (see apps/api/src/configure-app.ts
# for why this must be a hop COUNT, not `true`). Unset/0 = trust none — correct for a direct
# `pnpm dev:api` on 0.0.0.0, with no proxy in front. Production sits behind exactly one proxy
# (nginx, apps/web/nginx.conf) that correctly appends the real client IP to X-Forwarded-For —
# set TRUST_PROXY=1 there, and ONLY there. Never set this on a deployment reachable directly
# from the internet: it would let a client's own X-Forwarded-For be trusted as the client IP,
# defeating the per-IP rate limiting (AUTH_RATE_LIMIT, common/rate-limit.constants.ts).
TRUST_PROXY=0
