DATABASE_URL=postgresql://dnd:dnd@localhost:5432/dnd
# The API refuses to start if this is shorter than 32 characters -- generate a real
# random value for any non-local environment, e.g. `openssl rand -base64 32`.
JWT_SECRET=
JWT_EXPIRES_IN=7d
PORT=3000
SENTRY_DSN=
# Not needed for normal local dev -- Vite already proxies /api same-origin (apps/web/vite.config.ts),
# same as nginx does in production. Only set this if a browser needs to call the API directly from
# a *different* origin during development. Comma-separated list of allowed origins; unset = no CORS.
CORS_ORIGIN=
# Number of trusted reverse-proxy hops in front of the API (see apps/api/src/configure-app.ts
# for why this must be a hop COUNT, not `true`). COUNT THE PROXIES, do not copy a number:
# Fastify trusts N hops counting IN from the socket, so N must equal how many proxies sit
# between the client and this process in THIS deployment.
#   0  no proxy at all           -- a direct `pnpm dev:api` on 0.0.0.0. The default.
#   1  one proxy                 -- the API sitting directly behind a single reverse proxy.
#   2  Traefik -> nginx -> API   -- the production topology on vps1new (docs/03-despliegue.md):
#      Coolify's Traefik terminates TLS and hands the request to apps/web/nginx.conf, whose
#      `proxy_add_x_forwarded_for` APPENDS Traefik's IP. Setting 1 there would key the rate
#      limiter on Traefik's own IP -- identical for every visitor on Earth -- collapsing the
#      per-IP login limit into one shared bucket anyone can exhaust to lock everybody out.
# Never set a value HIGHER than the real number of proxies, and never `true`: both let a
# client's own X-Forwarded-For be trusted as the client IP, defeating the per-IP rate
# limiting (AUTH_RATE_LIMIT, common/rate-limit.constants.ts).
TRUST_PROXY=0
# Overrides AUTH_RATE_LIMIT_DEFAULT (5/minute, common/rate-limit.constants.ts) on the
# brute-forceable auth endpoints. Exists ONLY for the Playwright browser suite
# (apps/web/e2e), where every test registers/logs in from the same machine and therefore the
# same IP -- one shared bucket that the real 5/minute limit throttles by the sixth test. Set
# high in exactly two places: apps/web/playwright.config.ts's API webServer `env`, and the
# `e2e-browser` job in .github/workflows/ci.yml. Unset (or a non-numeric / non-positive value)
# falls back to the real default -- it can never disable the limit.
# NEVER set this in production or in any environment reachable from the internet: it is the
# brute-force protection on login, register, invite-accept and password-change.
AUTH_RATE_LIMIT=
# Overrides DEFAULT_RATE_LIMIT_FALLBACK (100/minute, common/rate-limit.constants.ts) -- the
# GLOBAL limit that applies to every route, not just the auth ones. Exists for the same single
# reason and with the same rule: set high ONLY in apps/web/playwright.config.ts's API webServer
# `env`, never in production. The browser suite drives one browser from one IP through hundreds
# of real requests a minute, so with the production value the API starts answering 429 and the
# journeys fail in a different place each run -- which looks exactly like flaky code and is not.
# Unset, non-numeric or non-positive falls back to 100; it can never disable the limit.
RATE_LIMIT=
