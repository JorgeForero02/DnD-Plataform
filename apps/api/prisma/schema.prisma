generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  DM
  PLAYER
}

enum Visibility {
  PUBLIC
  PLAYERS
  SPECIFIC_PLAYERS
  OWNER_DM
  DM_ONLY
}

enum SessionStatus {
  PLANNED
  IN_PROGRESS
  CLOSED
}

// Tarea 2.5.2 — un encuentro es un estado del combate, no un tipo de sesión más: **ACTIVE** es
// la única que participa en el índice único parcial de abajo («como mucho un encuentro activo
// por sesión»); ENDED es el estado final y no vuelve a activarse.
enum EncounterStatus {
  ACTIVE
  ENDED
}

// Tarea 2A.5. Arranca corto a propósito: 2C añade DICE_ROLLED, CONDITION_APPLIED,
// CONDITION_REMOVED y CLOCK_ADVANCED; la fase 3 añade TOKEN_MOVED. Anadir un tipo es anadir un
// valor aqui y un miembro a la union de Zod de packages/shared/src/game-event.schema.ts, que es
// la fuente unica; una prueba comprueba que los dos lados no se separan.
enum GameEventType {
  CLOCK_ADVANCED
  CONDITION_EXPIRED
  TABLE_ROLLED
  SESSION_STARTED
  SESSION_CLOSED
  REST_DECLARED
  HP_CHANGED
  TEMP_HP_SET
  RESOURCE_SPENT
  RESOURCE_RESTORED
  LEVEL_CHANGED
  ABILITY_ROLL
  MANUAL_OVERRIDE_SET
  DEATH_SAVE
  CONDITION_APPLIED
  CONDITION_REMOVED
  ENTITY_OPENED
  ENTITY_REVEALED
  ENTITY_LINKED
  FLAG_SET
  SET_CHANGED
  SIGNAL_RAISED
  SESSION_NOTE
  // La bolsa (2B): un movimiento de dinero es un tipo propio, no una senal generica.
  MONEY_CHANGED
  // El inventario (auditoria de mecanica de 2B): el dinero dejaba rastro y los objetos no.
  ITEM_ADDED
  ITEM_MOVED
  ITEM_REMOVED
  // La iniciativa y el orden de turnos (2.5.2): empezar el encuentro, pasar turno y subir de
  // asalto son los tres momentos que la mesa quiere ver en la línea de tiempo.
  ENCOUNTER_STARTED
  TURN_ADVANCED
  ROUND_ADVANCED
  // Y terminarlo (2.5.6): entrar en combate es un momento, y salir también. Sin este suceso la
  // línea de tiempo tiene un principio y ningún final.
  ENCOUNTER_ENDED
  // Archivar un personaje en vez de borrarlo (2.5.8, ficha M9).
  ATTACK_RESOLVED
  CHARACTER_ARCHIVED
  CHARACTER_RESTORED
  // Ola 3 (2026-09-04): dos disparadores que el editor de reglas ofrecia y el motor no podia
  // cumplir porque no existian como suceso. Ahora los escribe su gesto.
  ENTITY_COMMENTED
  MEMBER_JOINED
}

enum ResourceReset {
  NONE
  SHORT_REST
  LONG_REST
}

// Quien puede subir un recurso. El caso estrecho de permisos por campo que 2A si necesita:
// la inspiracion la da el DM, la furia la gasta y la recupera su dueno.
enum ResourceGrantor {
  DM_ONLY
  OWNER
}

enum RuleMode {
  AUTOMATIC
  PROPOSAL
}

enum RuleStatus {
  ARMED
  DISARMED
  // Apunta a algo que ya no existe. **Rota y marcada, nunca descartada en silencio** (hueco H7).
  BROKEN
}

enum RuleTraceStatus {
  APPLIED
  // Modo propuesta: la regla decidio, y espera al DM. No ha cambiado nada.
  PROPOSED
  REJECTED
  // Se corto por el tope de saltos, por el tope de disparos, o por el interruptor de campana.
  STOPPED
  // Dos reglas igual de especificas se contradicen: se marca, no se resuelve a escondidas.
  CONFLICT
}

enum RestKind {
  SHORT
  LONG
}

/// Fase 2D. Los seis tamanos del SRD 5.1. De aqui sale el dado de golpe de una criatura.
enum CreatureSize {
  TINY
  SMALL
  MEDIUM
  LARGE
  HUGE
  GARGANTUAN
}

/// Fase 2D. Los catorce tipos de criatura del SRD 5.1.
enum CreatureType {
  ABERRATION
  BEAST
  CELESTIAL
  CONSTRUCT
  DRAGON
  ELEMENTAL
  FEY
  FIEND
  GIANT
  HUMANOID
  MONSTROSITY
  OOZE
  PLANT
  UNDEAD
}

enum EntityType {
  NPC
  LOCATION
  QUEST
  FACTION
  OBJECT
  EVENT
  DOCUMENT
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String
  displayName       String
  isAdmin           Boolean   @default(false)
  createdAt         DateTime  @default(now())
  // Set on every successful password change (never on creation). JwtStrategy.validate
  // rejects any token whose `iat` predates this, so changing your password invalidates
  // every token issued before the change — "changing your password logs you out everywhere".
  passwordChangedAt DateTime?
}

model Campaign {
  id          String           @id @default(cuid())
  name        String
  description String?
  ownerId     String
  createdAt   DateTime         @default(now())
  members     CampaignMember[]
  entities    Entity[]
  sessions    Session[]
  invites     Invite[]
  characters  Character[]
  gameEvents  GameEvent[]
  flags       CampaignFlag[]
  sets        CampaignSet[]
  rules       Rule[]
  items       CampaignItem[]
  rollRequests RollRequest[]
  tables      DmTable[]

  // Interruptor general del motor, por campana (contencion operativa, punto 6 de la spec de
  // autoridad). Un DM que ve algo raro lo apaga entero sin tener que desarmar regla por regla.
  rulesEnabled Boolean @default(true)

  // Las tablas de la casa (2C.6): **apagadas por defecto**. Con el interruptor apagado, un
  // critico sigue duplicando dados y nada mas, que es lo que dice el manual. El SRD no trae
  // ninguna tabla de criticos ni de pifias: todas las que circulan son caseras, y una casa que
  // cambia una regla lo hace a la vista.
  houseTablesEnabled Boolean @default(false)

  // El reloj de la campana (2C.3): **segundos de juego**, no una fecha. Un asalto son seis, asi
  // que la iniciativa de Encuentros avanzara este mismo contador de seis en seis. Un calendario
  // es una capa de presentacion encima; al reves no se puede.
  clockSeconds Int @default(0)
  statblocks CampaignStatblock[]
}

model CampaignMember {
  id         String   @id @default(cuid())
  campaignId String
  userId     String
  role       Role
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
}

model Invite {
  id         String    @id @default(cuid())
  campaignId String
  token      String    @unique
  role       Role      @default(PLAYER)
  createdAt  DateTime  @default(now())
  usedAt     DateTime?
  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model Entity {
  id          String                  @id @default(cuid())
  campaignId  String
  type        EntityType
  name        String
  body        Json?
  tags        String[]                @default([])
  visibility  Visibility              @default(DM_ONLY)
  createdById String
  createdAt   DateTime                @default(now())
  campaign    Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  grants      EntityVisibilityGrant[]
  linksFrom   EntityLink[]            @relation("linkFrom")
  linksTo     EntityLink[]            @relation("linkTo")
  comments    Comment[]
  /// Las sesiones que abren su escena en esta ficha. Lado inverso de `Session.openingEntity`.
  opensSessions Session[]             @relation("SessionOpeningEntity")
}

model EntityLink {
  id     String  @id @default(cuid())
  fromId String
  toId   String
  label  String?
  from   Entity  @relation("linkFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to     Entity  @relation("linkTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId, label])
}

model EntityVisibilityGrant {
  id       String @id @default(cuid())
  entityId String
  userId   String
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, userId])
}

model Comment {
  id        String   @id @default(cuid())
  entityId  String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  entity    Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
}

model Session {
  id          String        @id @default(cuid())
  campaignId  String
  title       String
  scheduledAt DateTime?
  notes       Json?
  visibility  Visibility    @default(PLAYERS)
  createdAt   DateTime      @default(now())
  status      SessionStatus @default(PLANNED)
  startedAt   DateTime?
  endedAt     DateTime?
  // Quien vino y con que personaje: [{ userId, characterId? }]. Se declara al empezar la sesion.
  //
  // **Json y no tabla, a proposito y con su motivo.** La convencion del proyecto manda promover a
  // columna todo lo que se consulte o se filtre; de la asistencia hoy no se consulta nada — se
  // lee entera con la sesion y se pinta. El dia que haga falta "en cuantas sesiones estuvo este
  // jugador", se promociona a tabla y esa consulta es la que lo justifica, no una sospecha.
  //
  // Y hace falta declararla porque **esto no tiene conexiones en vivo**: los VTT saben quien esta
  // porque hay un socket abierto. Aqui no lo hay, asi que quien vino es un dato que alguien dice.
  attendance  Json?

  /// **Dónde abre la escena**: la ficha del mundo por la que empieza esta sesión.
  ///
  /// `onDelete: SetNull` y NO `Cascade`: borrar un lugar del mundo no puede borrar la sesión que
  /// pasó allí. Y **nunca se guarda el nombre del lugar como texto** — se queda viejo, no enlaza y
  /// no respeta la visibilidad.
  ///
  /// **Lo que se devuelve pasa por `canView` con el espectador delante**: un jugador que no puede
  /// ver «El Santuario Sellado» no recibe ni su nombre **ni su id**, y el campo llega **ausente**,
  /// no `null` — ausente y presente-pero-vacío son cosas distintas para quien pinta.
  openingEntityId String?
  openingEntity   Entity? @relation("SessionOpeningEntity", fields: [openingEntityId], references: [id], onDelete: SetNull)

  campaign    Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  encounters  Encounter[]

  // Como maximo una sesion IN_PROGRESS por campana. Lo garantiza un indice unico PARCIAL, que
  // Prisma no sabe expresar y va como SQL crudo dentro de la migracion:
  //   CREATE UNIQUE INDEX "session_one_in_progress_per_campaign"
  //     ON "Session" ("campaignId") WHERE "status" = 'IN_PROGRESS';
  // Una comprobacion en el servicio seria una carrera esperando a ocurrir en cuanto el DM tenga
  // dos pestanas abiertas, y por eso su prueba es e2e contra Postgres real y no unitaria.

  @@index([openingEntityId])
}

// Tarea 2.5.2 — el encuentro cuelga de la sesión, que ya es el estado mutable de la partida.
//
// **`round` y `activePosition` son lo único mutable aquí.** El orden en sí —quién combate y en
// qué posición— se calcula UNA VEZ al empezar (el SRD: «el orden no cambia de asalto a
// asalto») y se guarda en `Combatant`, no se recalcula al pasar turno.
model Encounter {
  id             String          @id @default(cuid())
  sessionId      String
  status         EncounterStatus @default(ACTIVE)
  // Empieza en el asalto 1, como en la mesa: no hay "asalto 0".
  round           Int            @default(1)
  // La posición (`Combatant.position`) de quien tiene el turno ahora mismo.
  activePosition  Int            @default(0)
  createdAt      DateTime        @default(now())
  session        Session         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  combatants     Combatant[]

  // Como máximo un encuentro ACTIVE por sesión. Mismo patrón que
  // "session_one_in_progress_per_campaign": un índice único PARCIAL que Prisma no sabe expresar
  // en el esquema y va como SQL crudo dentro de la migración:
  //   CREATE UNIQUE INDEX "encounter_one_active_per_session"
  //     ON "Encounter" ("sessionId") WHERE "status" = 'ACTIVE';
  // Una comprobación en el servicio sería una carrera esperando a ocurrir en cuanto el DM tenga
  // dos pestañas abiertas, y por eso su prueba es e2e contra Postgres real y no unitaria.
}

// Un combatiente **apunta a un `Character`** — desde 2D un PNJ en la mesa ES una fila de
// `Character`, así que no hace falta un segundo tipo. Los seis goblins de un mismo grupo (2.5.2,
// "se tira en grupo") son SEIS filas de `Combatant` — una por cada `Character` — que comparten
// el mismo `initiative` porque compartieron la misma tirada, no una fila compartida.
//
// **`position` es la que ordena los turnos, y es de la base, no del servicio.** "Una posición no
// se repite en un encuentro" es un índice único normal (Prisma sí lo expresa): dos combatientes
// con la misma posición son un estado inconsistente, no una carrera a medias.
/// El bando de un combatiente **dentro de este encuentro**, y por eso vive aquí y no en
/// `Character`. «Enemigo» no es una propiedad de una criatura: es una relación en un momento. Un
/// `Character.faction` habría que mantenerlo sincronizado con la ficción y se pudre el día que el
/// mercader se vuelve enemigo; aquí es un dato de vida corta que **muere con el encuentro**.
enum CombatantSide {
  ALLY
  ENEMY
  NEUTRAL
}

model Combatant {
  id          String    @id @default(cuid())
  encounterId String
  characterId String
  // El número de iniciativa, **editable por el DM** tras la tirada (el SRD deja los empates a
  // su criterio). Es el resultado de una prueba de Destreza, no una columna que se recalcula.
  initiative  Int
  /// La clave del GRUPO al que pertenece: `statblockRef` para los idénticos de 2D, y su propio
  /// id para quien no tiene ninguno. Se guarda —en vez de recalcularla desde `Character`— porque
  /// el DM puede **sacar a uno de su grupo** corrigiendo su iniciativa, y eso es un hecho del
  /// encuentro, no del personaje.
  groupKey    String

  /// 0-based. Fija el orden de turnos y NO cambia de asalto a asalto.
  ///
  /// **La posicion es del GRUPO, no del combatiente, y varios combatientes la comparten.** Sale
  /// del SRD y no de una preferencia: *«The DM makes one roll for an entire group of identical
  /// creatures, so each member of the group acts at the same time.»* Actuar a la vez es ocupar
  /// **una sola entrada** del orden. Dos personajes y seis goblins son ocho combatientes y
  /// **siete posiciones**.
  position    Int

  /// **`NEUTRAL` por defecto, y no `ENEMY`.** Los combatientes que ya existen se crearon sin
  /// bando, y un valor por defecto que **afirme** algo convertiría filas viejas en una afirmación
  /// que nadie hizo. `NEUTRAL` significa literalmente «no se ha dicho».
  ///
  /// **Lo pone el DM al empezar el encuentro; el servidor no lo adivina** — no hay ningún dato del
  /// que deducirlo. Ni el tipo de ficha ni la visibilidad sirven: un PNJ `DM_ONLY` puede ser el
  /// aliado que aparece a mitad de escena.
  side        CombatantSide @default(NEUTRAL)

  createdAt   DateTime  @default(now())
  encounter   Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  /// **La restriccion correcta es esta, y la primera version puso otra.** Aqui habia
  /// `@@unique([encounterId, position])`, que hacia imposible el agrupamiento y obligaba a dar
  /// ocho posiciones a ocho combatientes — seis turnos de goblin seguidos en vez de uno. El
  /// error salio de mi encargo, que pidio «una posicion no se repite» sin pensarlo; el
  /// implementador lo declaro en vez de elegir un numero en silencio, que es lo correcto.
  /// Lo que la base SI puede garantizar, y es lo que de verdad importa: **un personaje no
  /// aparece dos veces en el mismo encuentro**.
  @@unique([encounterId, characterId])
  @@index([encounterId])
  @@index([characterId])
}

// Log append-only de la partida. NUNCA es la fuente del estado: el estado se lee de sus
// columnas y esto cuenta que lo cambio. Todo lo que se consulta o se filtra es columna real;
// el payload solo lleva el detalle que se pinta en una linea de la linea de tiempo.
model GameEvent {
  id          String        @id @default(cuid())
  campaignId  String
  sessionId   String?
  actorUserId String
  type        GameEventType
  subjectType String
  subjectId   String
  payload     Json
  /// Tarea 2.5.1 — promovido de `payload` a columna porque hay que poder filtrar por él: "¿de
  /// qué murió Elara?" es una pregunta que un campo dentro de un Json no puede contestar barato.
  /// **Opcional a propósito**: todo el historial ya escrito no lo tiene, y un `HP_CHANGED` sin
  /// tipo de daño sigue siendo válido (una curación, un chasquido de dedos del DM).
  damageType  DamageType?
  visibility  Visibility    @default(PLAYERS)
  createdAt   DateTime      @default(now())
  campaign    Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
  @@index([sessionId, createdAt])
  @@index([subjectType, subjectId, createdAt])
  @@index([subjectType, subjectId, damageType])
}

model Character {
  id         String     @id @default(cuid())
  campaignId String
  ownerId    String
  name       String
  // `race` y `class` son texto libre HEREDADO y se conservan a proposito: puede haber
  // personajes escritos a mano en la mesa del autor, y borrarles el texto seria destruir datos
  // por una migracion de conveniencia. La hoja los muestra solo si no hay clave. Se retiran
  // cuando el autor confirme que no queda ninguno.
  race       String?
  class      String?
  level      Int        @default(1)
  bio        String?
  visibility Visibility @default(PLAYERS)
  createdAt  DateTime   @default(now())

  // Archivar en vez de borrar (2.5.8, ficha M9). **`null` = activo, con fecha = archivado.**
  // No es un booleano: guardar CUANDO se archivo es gratis aqui y cuesta una consulta aparte en
  // cualquier otro sitio, y la mesa ya pregunta "desde cuando esta guardado". La misma consulta
  // que ya excluye a los PNJ instanciados (`statblockRef: null`, 2D.6) suma este filtro —no se
  // inventa una tabla ni un segundo listado— y NADA se borra: hoja, inventario y dinero siguen
  // en sus filas de siempre.
  archivedAt DateTime?

  // --- La hoja de 5.a edicion (2A.6). Se guarda lo DECIDIDO, nunca lo calculado ---
  // Seis columnas y no un JSON: son seis, son fijas, y hay que poder consultarlas.
  str        Int?
  dex        Int?
  con        Int?
  int        Int?
  wis        Int?
  cha        Int?
  raceKey    String?
  subraceKey String?
  classKey   String?
  // Las elecciones resueltas, por clave de concesion: { "half-elf-asi": ["dex","int"] }.
  choices    Json?
  // Casillas de equipo. **Vacia en 2A**: se modela en 2B, pero la columna existe desde ahora
  // porque anadirla despues de que existan mil personajes cuesta una migracion con datos.
  equippedSlots Json?
  // Anulaciones manuales del DM sobre valores DERIVADOS: { "ac": 18, "maxHp": 40 }.
  //
  // **La valvula de escape del "se guarda lo decidido, se calcula lo derivado".** El catalogo
  // del SRD no lo cubre todo —un objeto magico, un don, una regla de la casa, un PNJ con una CA
  // que el DM decide y punto— y sin esto la unica salida era mentirle a la ficha (subir una
  // caracteristica para que cuadre la CA) o no usar la aplicacion en esa mesa.
  //
  // No sustituye al equipo (2B): un dia habra armadura de verdad y esto seguira existiendo,
  // porque siempre habra un numero que el DM decide. Se aplica como un `override` del motor,
  // asi que **sale en la traza con su delta** y nadie se pregunta de donde viene el numero.
  overrides     Json?

  // --- Estado mutable (2A.7). PG maximos NO se guardan: se calculan ---
  // `null` = a PG maximos; se materializa al primer cambio.
  currentHp  Int?
  // No se suman a los actuales: se gastan primero, y dos fuentes no se acumulan.
  tempHp     Int        @default(0)
  // Concurrencia optimista para las correcciones absolutas del DM.
  version    Int        @default(0)
  // Tiradas de salvacion contra muerte: tres y tres, casillas y no un numero.
  deathSaveSuccesses Int @default(0)
  deathSaveFailures  Int @default(0)

  /// Fase 2D — si esto tiene valor, este «personaje» es un PNJ instanciado desde un statblock:
  /// `SRD:goblin` o `CAMPAIGN:<id>`. Entonces `classKey`, `raceKey` y `level` NO se usan, y sus
  /// numeros derivados salen del statblock por el camino de monstruo del motor.
  ///
  /// **Cadena y no clave foranea a proposito**, igual que `ResolvedItem.ref` de 2B: el catalogo
  /// del SRD vive en codigo y no tiene fila a la que apuntar.
  statblockRef String?

  // Cuando termino el ultimo descanso largo, **en segundos del reloj de la campana** (2C.3).
  // El SRD: «a character can't benefit from more than one long rest in a 24-hour period», y sin
  // este dato esa regla no se puede comprobar — hoy se puede descansar largo tres veces seguidas
  // y curarse entero cada vez. `null` = todavia no ha descansado largo en esta campana.
  lastLongRestClock Int?

  // --- La bolsa (2B, hueco H6). Cinco columnas y no un total normalizado: la mesa dice «tres
  // monedas de plata», no «0,3 po», y un total en oro obliga a decidir que hacer con 12,37 ya
  // escritos el dia que alguien quiera las cinco. ---
  cp         Int        @default(0)
  sp         Int        @default(0)
  ep         Int        @default(0)
  gp         Int        @default(0)
  pp         Int        @default(0)

  campaign   Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  resources  CharacterResource[]
  conditions CharacterCondition[]
  inventory  InventoryItem[]
  rollRequests RollRequest[]
  combatants Combatant[]

  @@index([campaignId])
}

// Recursos consumibles (2A.8): inspiracion, furia, ki, dados de golpe, espacios de conjuro.
// Todos son el mismo mecanismo — un contador con maximo que un descanso repone — y por eso
// son una tabla y no seis columnas.
model CharacterResource {
  id          String          @id @default(cuid())
  characterId String
  key         String
  // Texto que ve el jugador, en espanol.
  label       String
  current     Int
  // `null` = sin tope conocido.
  max         Int?
  resetOn     ResourceReset   @default(NONE)
  grantedBy   ResourceGrantor @default(OWNER)
  character   Character       @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, key])
}

// Condiciones (2A.12). **Clave libre**, no un enum cerrado: las quince del SRD tienen efecto
// mecanico y el motor las entiende; cualquier otra se guarda, se ensena y no calcula nada.
// El informe de huecos aviso de que un enum cerrado deja fuera «concentrandose en Bendicion»,
// y anadirla despues seria una migracion de enum.
model CharacterCondition {
  id          String    @id @default(cuid())
  characterId String
  key         String
  // Nivel, para el agotamiento (1..6). `null` en las que no lo tienen.
  level       Int?
  // Cuando vence, **en segundos del reloj de la campana** (2C.4). `null` = indefinida.
  //
  // **No hay columna `expired`**: si esta vencida es una resta contra el reloj, y guardarlo seria
  // una segunda verdad que puede discrepar de la primera. Ademas obligaria a un barrido periodico
  // que, si no corre, dejaria una condicion frenando a alguien despues de su hora.
  expiresAtClock Int?
  note        String?
  appliedById String
  createdAt   DateTime  @default(now())
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, key])
  @@index([characterId])
}

// Una tabla del DM (2C.6). **Primitiva, no «funcionalidad de pifias»**: tirar sobre una tabla con
// sus resultados y su visibilidad sirve igual para botin, rumores y encuentros aleatorios.
model DmTable {
  id          String     @id @default(cuid())
  campaignId  String
  name        String
  description String?
  visibility  Visibility @default(DM_ONLY)
  // Para que se consulta sola: NONE (solo a mano), CRITICAL o FUMBLE.
  trigger     String     @default("NONE")
  createdAt   DateTime   @default(now())
  entries     DmTableEntry[]
  campaign    Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

// Una fila: **un rango y un texto**. Rango y no un numero suelto porque asi se escribe una tabla de
// verdad —«01-20: se te encasquilla el arma»— y porque una de d100 con cien filas de un numero cada
// una es la misma tabla escrita cien veces.
model DmTableEntry {
  id      String  @id @default(cuid())
  tableId String
  min     Int
  max     Int
  text    String
  table   DmTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([tableId])
}

// Peticion de tirada (2C.5). **El DM pide, el jugador tira, el DM ve el resultado.**
//
// Es una tabla y no un `GameEvent` porque tiene **estado**: nace pendiente y se responde, y el log
// de partida es un registro de hechos que no se modifican. Ademas hay que poder preguntar «que me
// han pedido», que es una consulta por columnas, no un recorrido del log.
model RollRequest {
  id            String   @id @default(cuid())
  campaignId    String
  // A quien se le pide. Una peticion por personaje, aunque el DM pida a cinco a la vez: asi cada
  // uno tira con SU modificador y el registro no tiene que desenredar despues quien fallo.
  characterId   String
  requestedById String
  // Que valor de la hoja se tira: `skill.perception`, `save.con`. **No una expresion**: el
  // modificador lo pone el servidor con la hoja de quien tira, en el momento de tirar.
  key           String
  label         String
  dc            Int?
  mode          String   @default("NORMAL")
  audience      String   @default("PUBLIC")
  createdAt     DateTime @default(now())
  // Cuando se respondio y con que tirada. `null` = pendiente, que es lo que la pantalla sondea.
  resolvedAt    DateTime?
  resolvedEventId String?
  campaign      Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  character     Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([campaignId, resolvedAt])
  @@index([characterId, resolvedAt])
}

// Bandeja de notificaciones (2A.14). Sin tiempo real: se pide al cargar.
model Notification {
  id          String   @id @default(cuid())
  userId      String
  campaignId  String?
  type        String
  // Datos para componer la frase en la web. **Nunca la frase**: el idioma es de la pantalla.
  payload     Json
  subjectType String?
  subjectId   String?
  readAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

// Marcas de campana (2A.15): «el puente esta caido». Un booleano con nombre.
model CampaignFlag {
  id         String   @id @default(cuid())
  campaignId String
  key        String
  value      Boolean  @default(true)
  setById    String
  updatedAt  DateTime @updatedAt
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, key])
}

// Conjuntos con nombre (2A.15): «los que saben lo del posadero».
model CampaignSet {
  id         String              @id @default(cuid())
  campaignId String
  key        String
  label      String
  campaign   Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  members    CampaignSetMember[]

  @@unique([campaignId, key])
}

model CampaignSetMember {
  id          String      @id @default(cuid())
  setId       String
  memberType  String
  memberId    String
  addedById   String
  createdAt   DateTime    @default(now())
  set         CampaignSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  // Anadir dos veces el mismo elemento NO lo duplica: los efectos son idempotentes.
  @@unique([setId, memberType, memberId])
}

// Tarea 2A.16 — una regla del motor de eventos.
//
// **El objetivo se fija al ARMARLA, nunca al dispararla.** Es la frontera de seguridad de todo
// esto y esta razonada en `docs/superpowers/specs/2026-09-02-autoridad-de-las-reglas-design.md`:
// una regla es una "sentencia preparada" cuya forma queda congelada al crearla. Los objetivos
// dinamicos por etiqueta quedan FUERA de la v1 porque un jugador puede poner una etiqueta, y eso
// convierte un dato que el jugador controla en una via de escalada.
//
// **Corre con la autoridad del DM que la armo**, nunca con la del jugador que la dispara, y la
// escritura pasa igualmente por `canView`. El actor que queda registrado es "regla X, delegada
// por el DM Y, disparada por Z".
model Rule {
  id          String     @id @default(cuid())
  campaignId  String
  name        String
  /// El DM que la armo. **Su autoridad es con la que corre el efecto.**
  createdById String
  mode        RuleMode   @default(AUTOMATIC)
  status      RuleStatus @default(ARMED)
  /// Sube en cada edicion. La traza guarda con QUE version se disparo, para que auditar una
  /// cascada vieja no dependa de que nadie haya tocado la regla desde entonces.
  version     Int        @default(1)

  /// Las tres partes de la frase, validadas por uniones discriminadas de Zod al escribir.
  trigger    Json
  conditions Json
  effects    Json

  /// Tope de disparos (contencion, punto 6). `null` = sin tope.
  maxFires    Int?
  fireCount   Int        @default(0)
  /// Para la condicion «esta regla no se ha disparado nunca» — el «once» de Ink.
  lastFiredAt DateTime?
  /// Por que quedo rota. Se ensena; no se borra la regla.
  brokenReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  campaign  Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  traces    RuleTrace[]

  @@index([campaignId, status])
}

// La traza de un disparo. **Es la funcionalidad, no un adorno**: responde «por que se revelo
// esto» y, con el antes y el despues de cada efecto, permite deshacerlo.
model RuleTrace {
  id          String          @id @default(cuid())
  campaignId  String
  ruleId      String
  /// La version de la regla que se disparo, no la actual.
  ruleVersion Int

  /// Auditoria completa (punto 5 de la spec de autoridad): quien disparo y quien delego.
  triggeredByUserId String
  delegatedByUserId String
  /// El `GameEvent` que la disparo, si lo hubo.
  triggerEventId    String?

  /// Salto dentro de la cascada, y el identificador que agrupa la cascada entera.
  depth   Int    @default(0)
  chainId String

  status RuleTraceStatus
  /// Un elemento por efecto, cada uno con su ANTES y su DESPUES. Sin eso, deshacer es imposible.
  effects Json
  /// Por que se paro, por que hay conflicto, o el motivo que escribio el DM al aplicar.
  reason  String?

  createdAt DateTime @default(now())
  rule      Rule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
  @@index([chainId])
  @@index([status])
}


// ============================================================================================
// Fase 2B — objetos, inventario y equipar.
//
// **La forma la manda `packages/shared/src/item.schema.ts`**, que es donde vive una sola vez; lo
// de aqui es su persistencia. Los datos de arma y de armadura son **columnas y no un Json**
// porque hay que poder consultarlos y porque la convencion lo pide (docs/04-convenciones.md: un
// Json no se consulta nunca por dentro). El unico Json es `effects`, que es una lista validada
// al escribir por una union discriminada de Zod.
// ============================================================================================

enum ItemKind {
  WEAPON
  ARMOR
  SHIELD
  CONSUMABLE
  GEAR
  OTHER
}

/// Donde esta el objeto. **Tres sitios, y la sintonizacion va aparte** (booleano): un anillo
/// sintonizado esta equipado, asi que `ATTUNED` como cuarto valor obligaria a elegir entre las
/// dos verdades.
enum ItemLocation {
  EQUIPPED
  CARRIED
  STORED
}

/// Las ranuras (hueco H1). Existen desde la primera migracion: anadirlas despues obliga a
/// adivinar a que ranura pertenece cada fila ya escrita.
enum EquipSlot {
  MAIN_HAND
  OFF_HAND
  ARMOR
  HEAD
  NECK
  CLOAK
  RING_1
  RING_2
  HANDS
  FEET
  OTHER
}

enum ArmorCategory {
  LIGHT
  MEDIUM
  HEAVY
  SHIELD
}

enum WeaponCategory {
  SIMPLE
  MARTIAL
}

enum WeaponRange {
  MELEE
  RANGED
}

enum DamageType {
  BLUDGEONING
  PIERCING
  SLASHING
  ACID
  COLD
  FIRE
  FORCE
  LIGHTNING
  NECROTIC
  POISON
  PSYCHIC
  RADIANT
  THUNDER
}

enum WeaponProperty {
  AMMUNITION
  FINESSE
  HEAVY
  LIGHT
  LOADING
  REACH
  SPECIAL
  THROWN
  TWO_HANDED
  VERSATILE
}

/// Un objeto propio de la campana: el *homebrew* que el documento fuente ya pedia. El catalogo
/// SRD **no** vive aqui: vive en codigo (`apps/api/src/rules/catalog/`), como razas y clases.
model CampaignItem {
  id          String   @id @default(cuid())
  campaignId  String
  name        String
  kind        ItemKind
  /// La prosa: que parece, de donde salio. La pidio por su nombre el DM asesor.
  description String?
  /// En **onzas**, entero. En libras el SRD tiene fracciones; en onzas no.
  weightOz    Int      @default(0)
  /// En **piezas de cobre**, la unidad mas pequena, para que no haya decimales.
  costCp      Int?
  /// Lista cerrada de efectos numericos, validada al escribir por `itemEffectSchema`.
  effects     Json?
  requiresAttunement Boolean @default(false)
  slot        EquipSlot?

  // --- Arma ---
  weaponCategory   WeaponCategory?
  weaponRange      WeaponRange?
  damageDice       String?
  damageType       DamageType?
  weaponProperties WeaponProperty[] @default([])
  versatileDice    String?
  rangeNormalFt    Int?
  rangeLongFt      Int?

  // --- Armadura o escudo ---
  armorCategory       ArmorCategory?
  baseAc              Int?
  /// `null` = sin tope (ligera); `2` en media; **`0` en pesada, que no suma nada**.
  dexCap              Int?
  strengthRequirement Int     @default(0)
  stealthDisadvantage Boolean @default(false)

  /// Un objeto propio nace **visible para la mesa** (hueco H9). El DM que prepara la mazmorra lo
  /// pone `DM_ONLY` a mano, y entonces no se le puede dar a un jugador sin subirle la
  /// visibilidad: eso es lo que evita que preparar sea filtrar.
  visibility  Visibility @default(PLAYERS)
  createdById String
  createdAt   DateTime   @default(now())

  campaign  Campaign                     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  grants    CampaignItemVisibilityGrant[]
  inventory InventoryItem[]

  @@index([campaignId])
}

model CampaignItemVisibilityGrant {
  id     String       @id @default(cuid())
  itemId String
  userId String
  item   CampaignItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, userId])
}

/// Una fila del inventario de un personaje. El objeto **puede venir de dos sitios** y solo de
/// uno: la clave del SRD o el identificador de un objeto de la campana.
model InventoryItem {
  id             String       @id @default(cuid())
  characterId    String
  srdKey         String?
  campaignItemId String?
  quantity       Int          @default(1)
  location       ItemLocation @default(CARRIED)
  slot           EquipSlot?
  attuned        Boolean      @default(false)
  /// Donde esta guardado, si lo esta: «en la posada», «en el carro».
  storedAt       String?
  note           String?
  createdAt      DateTime     @default(now())

  character    Character     @relation(fields: [characterId], references: [id], onDelete: Cascade)
  /// **`Restrict` y no `Cascade` a proposito**: borrar la definicion de un objeto no puede
  /// vaciar en silencio la mochila de tres personajes. El servicio lo traduce a un 409 que dice
  /// quien lo tiene.
  campaignItem CampaignItem? @relation(fields: [campaignItemId], references: [id], onDelete: Restrict)

  @@index([characterId])
  @@index([campaignItemId])
}


/// Fase 2D — un statblock propio del DM. El camino GENERAL: la mesa del autor usa sus propios
/// monstruos mas que los del libro, y el catalogo del SRD solo cubre quince.
///
/// Espeja `Statblock` de `packages/shared/src/statblock.schema.ts`, que es donde vive la forma.
/// Lo que aqui es columna es lo que hace falta consultar o filtrar; lo que es Json es lo que solo
/// se lee entero (los rasgos, las acciones), validado al escribir por Zod — el mismo criterio que
/// `CampaignItem.effects` de 2B.
model CampaignStatblock {
  id         String       @id @default(cuid())
  campaignId String
  name       String
  size       CreatureSize
  type       CreatureType
  subtype    String?
  alignment  String?

  /// La CA la DICE el statblock; no se deriva de ninguna formula de armadura.
  ac     Int
  /// El parentesis del libro: «armadura de cuero, escudo», «armadura natural».
  acNote String?

  /// Cuantos dados de golpe. El TAMANO del dado no se guarda: sale de `size`.
  hitDiceCount       Int
  /// Valvula de escape para un statblock que rompa la regla del tamano. Sale en la traza.
  hitDieSizeOverride Int?

  str Int
  dex Int
  con Int
  int Int
  wis Int
  cha Int

  /// Claves de caracteristica: ["str", "con"].
  saveProficiencies  String[] @default([])
  /// { "stealth": "expertise" } — el NIVEL de competencia, no el bono ya sumado, para que la
  /// traza pueda descomponerlo en vez de ensenar un numero sin origen.
  skillProficiencies Json?

  /// Prosa y no vocabulario cerrado: el tumulario resiste «contundente, cortante y perforante de
  /// ataques no magicos con armas que no sean de plata», que no es un tipo de dano.
  damageResistances     String[] @default([])
  damageImmunities      String[] @default([])
  damageVulnerabilities String[] @default([])
  conditionImmunities   String[] @default([])

  /// Tarea 2.5.1 - la MITAD ESTRUCTURADA de lo de arriba, que el servidor si sabe aplicar:
  /// `[{ damageType, effect: RESIST|IMMUNE|VULNERABLE, note? }]`. Las listas de prosa se quedan
  /// tal cual y siguen siendo lo que el DM lee; esto es lo que reduce el dano.
  ///
  /// `Json` y no columnas porque **no se consulta por dentro** - la convencion del proyecto solo
  /// obliga a promocionar a columna aquello por lo que hay que filtrar, y por lo que se filtra es
  /// por `GameEvent.damageType`. Se valida al escribir con `damageModifiersSchema` de
  /// `@dnd/shared`, nunca por confianza en quien llama.
  ///
  /// **Esta linea faltaba, y su ausencia fue un defecto real (2026-09-04):** la migracion
  /// `20260903211642_statblock_damage_modifiers` creaba la columna y el esquema no la declaraba,
  /// asi que un checkout limpio no compilaba y el siguiente `prisma migrate dev` habria propuesto
  /// BORRARLA. Sobrevivio a un `pnpm verify` en verde porque el cliente generado de aquella
  /// maquina si la tenia. Lo caza el build, no una prueba: por eso `pnpm build` esta dentro de
  /// `pnpm verify`.
  damageModifiers       Json?

  /// En pies, como el resto de la aplicacion.
  darkvisionFeet Int?
  otherSenses    String[] @default([])
  /// { "walk": 30, "fly": 60 } en pies.
  speeds         Json?
  languages      String?

  /// Valor de desafio. De aqui sale el bonificador de competencia, no de un nivel.
  cr Float

  /// Nombre y prosa. Se guardan y se pintan; NO se ejecutan — arbitrarlas es Encuentros.
  traits           Json?
  actions          Json?
  reactions        Json?
  legendaryActions Json?

  /// Nace DM_ONLY: preparar la mazmorra no puede ser filtrarla. El DM lo sube a PLAYERS cuando
  /// los jugadores conocen al bicho.
  visibility  Visibility @default(DM_ONLY)
  createdById String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}
