generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  DM
  PLAYER
}

enum Visibility {
  PUBLIC
  PLAYERS
  SPECIFIC_PLAYERS
  OWNER_DM
  DM_ONLY
}

enum SessionStatus {
  PLANNED
  IN_PROGRESS
  CLOSED
}

// Tarea 2A.5. Arranca corto a propósito: 2C añade DICE_ROLLED, CONDITION_APPLIED,
// CONDITION_REMOVED y CLOCK_ADVANCED; la fase 3 añade TOKEN_MOVED. Anadir un tipo es anadir un
// valor aqui y un miembro a la union de Zod de packages/shared/src/game-event.schema.ts, que es
// la fuente unica; una prueba comprueba que los dos lados no se separan.
enum GameEventType {
  SESSION_STARTED
  SESSION_CLOSED
  REST_DECLARED
  HP_CHANGED
  TEMP_HP_SET
  RESOURCE_SPENT
  RESOURCE_RESTORED
  LEVEL_CHANGED
  ABILITY_ROLL
  MANUAL_OVERRIDE_SET
  DEATH_SAVE
  CONDITION_APPLIED
  CONDITION_REMOVED
  ENTITY_OPENED
  ENTITY_REVEALED
  ENTITY_LINKED
  FLAG_SET
  SET_CHANGED
  SIGNAL_RAISED
}

enum ResourceReset {
  NONE
  SHORT_REST
  LONG_REST
}

// Quien puede subir un recurso. El caso estrecho de permisos por campo que 2A si necesita:
// la inspiracion la da el DM, la furia la gasta y la recupera su dueno.
enum ResourceGrantor {
  DM_ONLY
  OWNER
}

enum RestKind {
  SHORT
  LONG
}

enum EntityType {
  NPC
  LOCATION
  QUEST
  FACTION
  OBJECT
  EVENT
  DOCUMENT
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String
  displayName       String
  isAdmin           Boolean   @default(false)
  createdAt         DateTime  @default(now())
  // Set on every successful password change (never on creation). JwtStrategy.validate
  // rejects any token whose `iat` predates this, so changing your password invalidates
  // every token issued before the change — "changing your password logs you out everywhere".
  passwordChangedAt DateTime?
}

model Campaign {
  id          String           @id @default(cuid())
  name        String
  description String?
  ownerId     String
  createdAt   DateTime         @default(now())
  members     CampaignMember[]
  entities    Entity[]
  sessions    Session[]
  invites     Invite[]
  characters  Character[]
  gameEvents  GameEvent[]
  flags       CampaignFlag[]
  sets        CampaignSet[]
}

model CampaignMember {
  id         String   @id @default(cuid())
  campaignId String
  userId     String
  role       Role
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
}

model Invite {
  id         String    @id @default(cuid())
  campaignId String
  token      String    @unique
  role       Role      @default(PLAYER)
  createdAt  DateTime  @default(now())
  usedAt     DateTime?
  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model Entity {
  id          String                  @id @default(cuid())
  campaignId  String
  type        EntityType
  name        String
  body        Json?
  tags        String[]                @default([])
  visibility  Visibility              @default(DM_ONLY)
  createdById String
  createdAt   DateTime                @default(now())
  campaign    Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  grants      EntityVisibilityGrant[]
  linksFrom   EntityLink[]            @relation("linkFrom")
  linksTo     EntityLink[]            @relation("linkTo")
  comments    Comment[]
}

model EntityLink {
  id     String  @id @default(cuid())
  fromId String
  toId   String
  label  String?
  from   Entity  @relation("linkFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to     Entity  @relation("linkTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId, label])
}

model EntityVisibilityGrant {
  id       String @id @default(cuid())
  entityId String
  userId   String
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, userId])
}

model Comment {
  id        String   @id @default(cuid())
  entityId  String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  entity    Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
}

model Session {
  id          String        @id @default(cuid())
  campaignId  String
  title       String
  scheduledAt DateTime?
  notes       Json?
  visibility  Visibility    @default(PLAYERS)
  createdAt   DateTime      @default(now())
  status      SessionStatus @default(PLANNED)
  startedAt   DateTime?
  endedAt     DateTime?
  campaign    Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  // Como maximo una sesion IN_PROGRESS por campana. Lo garantiza un indice unico PARCIAL, que
  // Prisma no sabe expresar y va como SQL crudo dentro de la migracion:
  //   CREATE UNIQUE INDEX "session_one_in_progress_per_campaign"
  //     ON "Session" ("campaignId") WHERE "status" = 'IN_PROGRESS';
  // Una comprobacion en el servicio seria una carrera esperando a ocurrir en cuanto el DM tenga
  // dos pestanas abiertas, y por eso su prueba es e2e contra Postgres real y no unitaria.
}

// Log append-only de la partida. NUNCA es la fuente del estado: el estado se lee de sus
// columnas y esto cuenta que lo cambio. Todo lo que se consulta o se filtra es columna real;
// el payload solo lleva el detalle que se pinta en una linea de la linea de tiempo.
model GameEvent {
  id          String        @id @default(cuid())
  campaignId  String
  sessionId   String?
  actorUserId String
  type        GameEventType
  subjectType String
  subjectId   String
  payload     Json
  visibility  Visibility    @default(PLAYERS)
  createdAt   DateTime      @default(now())
  campaign    Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
  @@index([sessionId, createdAt])
  @@index([subjectType, subjectId, createdAt])
}

model Character {
  id         String     @id @default(cuid())
  campaignId String
  ownerId    String
  name       String
  // `race` y `class` son texto libre HEREDADO y se conservan a proposito: puede haber
  // personajes escritos a mano en la mesa del autor, y borrarles el texto seria destruir datos
  // por una migracion de conveniencia. La hoja los muestra solo si no hay clave. Se retiran
  // cuando el autor confirme que no queda ninguno.
  race       String?
  class      String?
  level      Int        @default(1)
  bio        String?
  visibility Visibility @default(PLAYERS)
  createdAt  DateTime   @default(now())

  // --- La hoja de 5.a edicion (2A.6). Se guarda lo DECIDIDO, nunca lo calculado ---
  // Seis columnas y no un JSON: son seis, son fijas, y hay que poder consultarlas.
  str        Int?
  dex        Int?
  con        Int?
  int        Int?
  wis        Int?
  cha        Int?
  raceKey    String?
  subraceKey String?
  classKey   String?
  // Las elecciones resueltas, por clave de concesion: { "half-elf-asi": ["dex","int"] }.
  choices    Json?
  // Casillas de equipo. **Vacia en 2A**: se modela en 2B, pero la columna existe desde ahora
  // porque anadirla despues de que existan mil personajes cuesta una migracion con datos.
  equippedSlots Json?

  // --- Estado mutable (2A.7). PG maximos NO se guardan: se calculan ---
  // `null` = a PG maximos; se materializa al primer cambio.
  currentHp  Int?
  // No se suman a los actuales: se gastan primero, y dos fuentes no se acumulan.
  tempHp     Int        @default(0)
  // Concurrencia optimista para las correcciones absolutas del DM.
  version    Int        @default(0)
  // Tiradas de salvacion contra muerte: tres y tres, casillas y no un numero.
  deathSaveSuccesses Int @default(0)
  deathSaveFailures  Int @default(0)

  campaign   Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  resources  CharacterResource[]
  conditions CharacterCondition[]

  @@index([campaignId])
}

// Recursos consumibles (2A.8): inspiracion, furia, ki, dados de golpe, espacios de conjuro.
// Todos son el mismo mecanismo — un contador con maximo que un descanso repone — y por eso
// son una tabla y no seis columnas.
model CharacterResource {
  id          String          @id @default(cuid())
  characterId String
  key         String
  // Texto que ve el jugador, en espanol.
  label       String
  current     Int
  // `null` = sin tope conocido.
  max         Int?
  resetOn     ResourceReset   @default(NONE)
  grantedBy   ResourceGrantor @default(OWNER)
  character   Character       @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, key])
}

// Condiciones (2A.12). **Clave libre**, no un enum cerrado: las quince del SRD tienen efecto
// mecanico y el motor las entiende; cualquier otra se guarda, se ensena y no calcula nada.
// El informe de huecos aviso de que un enum cerrado deja fuera «concentrandose en Bendicion»,
// y anadirla despues seria una migracion de enum.
model CharacterCondition {
  id          String    @id @default(cuid())
  characterId String
  key         String
  // Nivel, para el agotamiento (1..6). `null` en las que no lo tienen.
  level       Int?
  note        String?
  appliedById String
  createdAt   DateTime  @default(now())
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, key])
  @@index([characterId])
}

// Bandeja de notificaciones (2A.14). Sin tiempo real: se pide al cargar.
model Notification {
  id          String   @id @default(cuid())
  userId      String
  campaignId  String?
  type        String
  // Datos para componer la frase en la web. **Nunca la frase**: el idioma es de la pantalla.
  payload     Json
  subjectType String?
  subjectId   String?
  readAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

// Marcas de campana (2A.15): «el puente esta caido». Un booleano con nombre.
model CampaignFlag {
  id         String   @id @default(cuid())
  campaignId String
  key        String
  value      Boolean  @default(true)
  setById    String
  updatedAt  DateTime @updatedAt
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, key])
}

// Conjuntos con nombre (2A.15): «los que saben lo del posadero».
model CampaignSet {
  id         String              @id @default(cuid())
  campaignId String
  key        String
  label      String
  campaign   Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  members    CampaignSetMember[]

  @@unique([campaignId, key])
}

model CampaignSetMember {
  id          String      @id @default(cuid())
  setId       String
  memberType  String
  memberId    String
  addedById   String
  createdAt   DateTime    @default(now())
  set         CampaignSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  // Anadir dos veces el mismo elemento NO lo duplica: los efectos son idempotentes.
  @@unique([setId, memberType, memberId])
}
